#!name=钱迹自动记账网关 (直推云端版)
#!desc=配合 iOS 快捷指令使用，拦截本地请求并获取 Token 凭证数据，由快捷指令提供给云端 CF 完成 AI 解析与静默推送。
#!author=ykybl0060
#!homepage=https://github.com/ykybl/Loon
#!icon=https://raw.githubusercontent.com/ykybl/Loon/main/Icon/qianji.png

[Script]
# 监听官方接口，被动抓取最新的 Token 和资产分类数据
http-request ^https:\/\/api\.qianjiapp\.com\/(syncv2\/|category\/list|asset\/list) script-path=https://ghproxy.net/https://raw.githubusercontent.com/ykybl/Loon/main/Script/qianji_auto_shortcut.js?v=0009, requires-body=false, tag=钱迹凭证抓取

http-response ^https:\/\/api\.qianjiapp\.com\/(category\/list|asset\/list) script-path=https://ghproxy.net/https://raw.githubusercontent.com/ykybl/Loon/main/Script/qianji_auto_shortcut.js?v=0009, requires-body=true, tag=钱迹分类数据抓取

# 拦截快捷指令的虚拟网关请求，返回 Token 凭证（不读取 body，防止大图片导致 OOM）
http-request ^https:\/\/api\.qianjiapp\.com\/hijack_add_bill script-path=https://ghproxy.net/https://raw.githubusercontent.com/ykybl/Loon/main/Script/qianji_auto_shortcut.js?v=0009, requires-body=false, timeout=120, tag=钱迹凭证提取

# 拦截快捷指令的终极直推请求，自动注入本地凭证并转发给 CF (需读取 body 以获取 bill JSON)
http-request ^https:\/\/api\.qianjiapp\.com\/auto_push_bill script-path=https://ghproxy.net/https://raw.githubusercontent.com/ykybl/Loon/main/Script/qianji_auto_shortcut.js?v=0009, requires-body=true, timeout=120, tag=钱迹自动注入直推


[MitM]
hostname = api.qianjiapp.com

[Rule]
# ★★★ workers.dev 在中国大陆被 GFW 完全封锁，必须走代理节点！★★★
DOMAIN-SUFFIX,workers.dev,PROXY
# 自定义域名走直连
DOMAIN-SUFFIX,qianji.renflyp.dpdns.org,DIRECT
