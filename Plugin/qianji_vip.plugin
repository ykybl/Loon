[Script]
# 拦截官方 AI 解析请求，转发给自建后端
http-request ^https:\/\/(api\.qianjiapp\.com|qianji\.xxoojoke\.com)\/emmav2\/ocr2bill script-path=https://ghproxy.net/https://raw.githubusercontent.com/ykybl/Loon/main/Script/qianji_ocr_hijack.js?v=0017, requires-body=true, timeout=60, tag=钱迹自定义AI解析

# 拦截所有 api.qianjiapp.com 及备用域名的接口响应
# 作用1：修复 ec=8888/code=40009 账号异常弹窗
# 作用2：解锁 VIP 状态字段
http-response ^https:\/\/(api\.qianjiapp\.com|qianji\.xxoojoke\.com)\/ script-path=https://ghproxy.net/https://raw.githubusercontent.com/ykybl/Loon/main/Script/qianji_vip.js?v=0017, requires-body=true, timeout=10, tag=钱迹会员解锁+账号异常修复

[MITM]
hostname = api.qianjiapp.com, qianji.xxoojoke.com
