#!name = 华为运动健康 GT5 个人表盘与全量 VIP 免付费解锁
#!desc = 解锁华为运动健康 App 中 GT5 等手表的自定义/个人表盘上传以及全量表盘商店 VIP 会员权限与免付费下载。
#!author = ykybl0004
#!version = 2.0.0
#!system = iOS
#!system_version = 16.0
#!loon_version = 3.0.0
#!tag = 华为, 表盘, GT5, VIP

# ============================================================
# ⚠️ 重要说明
# 1. 自动拦截华为运动健康 App 及 H5 表盘商店的会员与权限 API
# 2. 安装后需在 Loon → 证书管理 中信任 CA 证书才能解密 HTTPS
# 3. 需确保启用 MITM 且包含匹配的域名
# ============================================================

[Script]

# 拦截华为主题/表盘/会员/权限校验/下单全量 API
http-response ^https?://[^/]*\.(hicloud|huawei|dbankcloud|dbankcdn)\.(com|cn)/(servicesupport|Ring|Ring2|v1|v2)/.* script-path=HWHealth_WatchFace.js, requires-body=true, timeout=15, tag=HW_WatchFace_Unlock

[MITM]
hostname = *.hicloud.com, *.huawei.com, *.dbankcloud.cn, *.dbankcdn.cn, api-drcn.theme.dbankcloud.cn, query.hicloud.com, contentcenter-drcn.dbankcdn.cn
