[Script]
# 拦截官方 AI 解析接口，转发给自建后端
http-request ^https:\/\/(api\.qianjiapp\.com|qianji\.xxoojoke\.com)\/emmav2\/ocr2bill script-path=https://ghproxy.net/https://raw.githubusercontent.com/ykybl/Loon/main/Script/qianji_ocr_hijack.js, requires-body=true, timeout=60, tag=钱迹自定义AI解析

[MITM]
hostname = api.qianjiapp.com, qianji.xxoojoke.com
